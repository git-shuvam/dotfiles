{
    /*
    ********************************************************************
    BUILT-IN
    ********************************************************************
    */
    // "accessibility.dimUnfocused.enabled": true,

    "chat.titleBar.openInAgentsWindow.enabled": false,
    "chat.tools.compressOutput.enabled": true,
    "chat.viewSessions.orientation": "stacked",

    "debug.terminal.clearBeforeReusing": true,

    "diffEditor.codeLens": true,
    "diffEditor.ignoreTrimWhitespace": true,

    "editor.codeActions.triggerOnFocusChange": true,
    "editor.codeActionsOnSave": { "source.fixAll.prettier": "always", "source.fixAll.ruff": "never", "source.organizeImports.ruff": "always" }, // "source.fixAll.oxc": "always", "source.format.oxc": "always",
    "editor.codeLens": true,
    "editor.codeLensFontFamily": "default",
    "editor.cursorBlinking": "expand",
    "editor.cursorSmoothCaretAnimation": "on",
    "editor.defaultColorDecorators": "always",
    "editor.fontFamily": "JetBrainsMono Nerd Font",
    "editor.fontLigatures": true,
    "editor.formatOnPaste": true,
    "editor.formatOnSave": true,
    "editor.formatOnSaveMode": "file",
    "editor.formatOnType": true,
    "editor.inlayHints.enabled": "offUnlessPressed",
    "editor.inlayHints.fontFamily": "default",
    "editor.linkedEditing": true,
    "editor.minimap.enabled": false,
    "editor.minimap.renderCharacters": false,
    "editor.rulers": [{ "column": 120, "color": "#888" }],
    "editor.scrollBeyondLastLine": false,
    "editor.semanticHighlighting.enabled": false,
    "editor.showFoldingControls": "always",
    "editor.tabCompletion": "on",
    "editor.trimWhitespaceOnDelete": true,
    "editor.unfoldOnClickAfterEndOfLine": true,

    "emmet.includeLanguages": { "django-html": "html" },

    "errorLens.messageBackgroundMode": "none",

    "explorer.autoReveal": "focusNoScroll",
    "explorer.compactFolders": false,
    "explorer.confirmDelete": false,
    "explorer.confirmDragAndDrop": false,
    "explorer.confirmPasteNative": false,
    "explorer.excludeGitIgnore": false,

    "extensions.autoCheckUpdates": false,
    "extensions.ignoreRecommendations": true,
    "extensions.supportNodeGlobalNavigator": true,

    "files.associations": { "*.css": "tailwindcss", "*just*": "just", "requirements/*.{txt,in}": "pip-requirements", "**/ghostty/*": "plaintext", "**/templates/**/*.html": "django-html", "**/compose/*.yml": "dockercompose", "*.compose.yml": "dockercompose" },
    "files.autoSave": "onFocusChange",
    "files.insertFinalNewline": true,
    "files.trimFinalNewlines": true,
    "files.trimTrailingWhitespace": true,

    "git.autofetch": "all",
    "git.blame.ignoreWhitespace": true,
    "git.ignoreSubmodules": true,

    "github.copilot.completions.chat.enabled": false,
    "github.copilot.enable": {
        "*": true,
        "plaintext": false,
        "markdown": false,
        "scminput": false,
        "python": true,
        "toml": true
    },
    "github.copilot.nextEditSuggestions.eagerness": "auto",
    "github.copilot.nextEditSuggestions.enabled": true,

    "[json][jsonc]": { "editor.defaultFormatter": "esbenp.prettier-vscode" },
    "json.format.enable": true,
    "json.format.keepLines": true,
    "json.schemaDownload.enable": true,
    "json.schemaDownload.trustedDomains": {
        "https://json.schemastore.org/pyproject.json": true,
        "https://json.schemastore.org/taplo.json": true,
        "https://raw.githubusercontent.com/SchemaStore/schemastore/master/src/schemas/json/pyproject.json": true,
        "https://turborepo.dev/schema.json": true,
        "https://ui.shadcn.com/schema.json": true
    },
    "json.schemas": [
        { "fileMatch": ["pyproject.toml"], "url": "https://json.schemastore.org/pyproject.json" },
        { "fileMatch": ["taplo.toml"], "url": "https://json.schemastore.org/taplo.json" }
    ],
    "json.validate.enable": true,

    "notebook.codeActionsOnSave": { "notebook.source.organizeImports.ruff": "explicit", "notebook.source.fixAll.ruff": "explicit" },
    "notebook.defaultFormatter": "charliermarsh.ruff",
    "notebook.formatOnCellExecution": true,
    "notebook.formatOnSave.enabled": true,
    "notebook.lineNumbers": "on",
    "notebook.markup.fontFamily": "default",
    "notebook.output.fontFamily": "default",

    "problems.defaultViewMode": "tree",
    "problems.showCurrentInStatus": true,

    "scm.compactFolders": false,
    "scm.defaultViewMode": "tree",
    "scm.diffDecorationsGutterPattern": { "added": true },
    "scm.repositories.explorer": true,
    "scm.repositories.selectionMode": "single",

    "search.collapseResults": "alwaysCollapse",
    "search.showLineNumbers": true,
    "search.smartCase": true,
    "search.useGlobalIgnoreFiles": true,
    "search.useParentIgnoreFiles": true,

    "security.workspace.trust.untrustedFiles": "open",

    "simpleBrowser.focusLockIndicator.enabled": false,

    "terminal.integrated.copyOnSelection": true,
    "terminal.integrated.cursorStyle": "underline",
    "terminal.integrated.fontFamily": "JetBrainsMono Nerd Font",
    "terminal.integrated.fontLigatures.enabled": true,
    "terminal.integrated.hideOnStartup": "always",
    "terminal.integrated.initialHint": false,
    "terminal.integrated.persistentSessionReviveProcess": "never",
    "terminal.integrated.rightClickBehavior": "paste",
    "terminal.integrated.smoothScrolling": true,
    "terminal.integrated.stickyScroll.enabled": false,
    "terminal.integrated.suggest.enabled": false,
    "terminal.integrated.suggest.quickSuggestions": { "commands": "on", "arguments": "on", "unknown": "off" },
    "terminal.integrated.suggest.suggestOnTriggerCharacters": true,
    "terminal.integrated.tabs.defaultColor": "terminal.ansiCyan",
    "terminal.integrated.tabs.defaultIcon": "robot",
    "terminal.integrated.tabs.description": "",
    "terminal.integrated.tabs.title": "${shellType}",

    "window.autoDetectColorScheme": true,
    "window.commandCenter": false,
    "window.confirmSaveUntitledWorkspace": false,
    "window.density.editorTabHeight": "compact",
    "window.newWindowDimensions": "maximized",
    "window.newWindowProfile": "Default",
    "window.systemColorTheme": "auto",

    "workbench.activityBar.compact": true,
    "workbench.browser.searchEngine": "google",
    "workbench.browser.showInTitleBar": true,
    "workbench.editor.closeOnFileDelete": true,
    "workbench.editor.empty.hint": "hidden",
    "workbench.editor.pinnedTabSizing": "compact",
    "workbench.editor.pinnedTabsOnSeparateRow": true,
    "workbench.editor.useModal": "off",
    "workbench.editorAssociations": { "*.copilotmd": "vscode.markdown.preview.editor", "*.md": "vscode.markdown.editor" },
    "workbench.iconTheme": "material-icon-theme",
    "workbench.panel.showLabels": false,
    "workbench.productIconTheme": "material-product-icons",
    "workbench.secondarySideBar.defaultVisibility": "hidden",
    "workbench.secondarySideBar.showLabels": false,
    "workbench.settings.editor": "json",
    "workbench.sideBar.location": "right",
    "workbench.tree.indent": 20,

    /*
    ********************************************************************
    PLUGINS
    ********************************************************************
    */

    /*
    ====================================================================
    MISC
    ====================================================================
    - SonarSource.sonarlint-vscode
    - streetsidesoftware.code-spell-checker
    - usernamehw.errorlens
    - tamasfe.even-better-toml
    - eamodio.gitlens
    - PKief.material-icon-theme
     */
    "cSpell.allowCompoundWords": true,
    "cSpell.files": ["*.py", "*.jsx?", "*.tsx?"],

    "errorLens.codeLensEnabled": true,
    "errorLens.enableOnDiffView": true,
    "errorLens.fontFamily": "default",

    "material-icon-theme.hidesExplorerArrows": true,
    // "sonarlint.automaticAnalysis": false,
    // "sonarlint.focusOnNewCode": true,

    /*
    ====================================================================
    LSP
    ====================================================================
    */

    /*
    --------------------------------------------------------------------
    JAVASCRIPT
    --------------------------------------------------------------------
    - esbenp.prettier-vscode
    */
    "[javascript][javascriptreact][typescript][typescriptreact][markdown]": { "editor.defaultFormatter": "esbenp.prettier-vscode", "editor.tabSize": 2 },
    "prettier.configPath": "~/.config/.prettierrc",

    /*
    --------------------------------------------------------------------
    PYTHON
    --------------------------------------------------------------------
    - astral-sh.ty
    - charliermarsh.ruff
    - jannchie.ruff-ignore-explainer
    - ms-python.debugpy
    - ms-python.python
    - ms-python.vscode-pylance
    - ms-python.vscode-python-envs
    - ms-toolsai.jupyter
    */
    "[python]": { "editor.defaultFormatter": "charliermarsh.ruff" },
    "[django-html]": { "editor.defaultFormatter": "junstyle.vscode-django-support" },
    "python.analysis.autoFormatStrings": true,
    "python.analysis.diagnosticMode": "workspace",
    "python.analysis.extraPaths": ["${workspaceFolder}"],
    "python.analysis.generateWithTypeAnnotation": true,
    "python.analysis.supportAllPythonDocuments": true,
    "python.analysis.supportDocstringTemplate": true,
    "python.languageServer": "Pylance",
    "python.terminal.useEnvFile": true,
    "python.testing.autoTestDiscoverOnSaveEnabled": true,
    "python.testing.cwd": "${workspaceFolder}/tests",
    "python.testing.pytestEnabled": true,
    "python.useEnvironmentsExtension": false,
    "ty.disableLanguageServices": true,

    /*
    --------------------------------------------------------------------
    ShellScript
    --------------------------------------------------------------------
    - mkhl.shfmt
    */
    "[shellscript]": { "editor.defaultFormatter": "mkhl.shfmt" },

    /*
    --------------------------------------------------------------------
    Rust
    --------------------------------------------------------------------
    - rust-lang.rust-analyzer
    */
    "[rust]": { "editor.defaultFormatter": "rust-lang.rust-analyzer" },

    /*
    --------------------------------------------------------------------
    TOML
    --------------------------------------------------------------------
    - tamasfe.even-better-toml
    */
    "[toml]": { "editor.defaultFormatter": "tamasfe.even-better-toml" },
    "evenBetterToml.schema.associations": {
        "pyproject.toml": "https://raw.githubusercontent.com/SchemaStore/schemastore/master/src/schemas/json/pyproject.json",
        "taplo.toml": "https://json.schemastore.org/taplo.json"
    },

    /*
    --------------------------------------------------------------------
    Yaml
    --------------------------------------------------------------------
    - redhat.vscode-yaml
    */
    "[yaml]": { "editor.defaultFormatter": "redhat.vscode-yaml" },
    "yaml.disableSchemaDetection": [],
    "docker.extension.enableComposeLanguageServer": false,

    /*
    --------------------------------------------------------------------
    LUA
    --------------------------------------------------------------------
    - sumneko.lua
    - JohnnyMorganz.stylua
    */
    "[lua]": { "editor.defaultFormatter": "JohnnyMorganz.stylua" }, // "sumneko.lua"
    "Lua.diagnostics.globals": ["vim"],
    "Lua.runtime.version": "LuaJIT",
    "Lua.workspace.library": ["~/.config/nvim", "~/.local/share/nvim", "/opt/homebrew/share/nvim/runtime", "/usr/local/share/nvim/runtime"],

    /*
    --------------------------------------------------------------------
    Docker
    --------------------------------------------------------------------
    - docker.docker
    - ms-azuretools.vscode-containers
    - ms-azuretools.vscode-docker
    - ms-vscode-remote.remote-containers

    "[dockercompose]": { "editor.defaultFormatter": "docker.docker" },
    "[dockerfile]": { "editor.defaultFormatter": "ms-azuretools.vscode-containers" },
    "docker.extension.enableComposeLanguageServer": false
    */

    /*
    --------------------------------------------------------------------
    vscodevim.vim
    --------------------------------------------------------------------
    */
    "vim.easymotion": true,
    "vim.incsearch": true, // default
    "vim.useSystemClipboard": true,
    "vim.useCtrlKeys": true, // default
    "vim.hlsearch": true,
    "vim.highlightedyank.enable": true,
    "vim.insertModeKeyBindings": [{ "before": ["j", "j"], "after": ["<Esc>"] }],
    "vim.normalModeKeyBindingsNonRecursive": [
        { "before": ["<leader>", "d"], "after": ["d", "d"] },
        { "before": ["<C-n>"], "commands": [":nohl"] },
        { "before": ["K"], "commands": ["lineBreakInsert"], "silent": true }
    ],
    "vim.leader": "<leader>",
    "vim.handleKeys": { "<C-a>": false, "<C-f>": false },
    "vim.normalModeKeyBindings": [
        { "before": ["<C-n>"], "commands": [":nohl"] },
        { "before": ["leader", "w"], "commands": ["workbench.action.files.save"] }
    ],
    "vim.operatorPendingModeKeyBindings": [
        { "before": ["{"], "after": ["w"] },
        { "before": ["L"], "after": ["$"] },
        { "before": ["H"], "after": ["^"] }
    ],

    "vim.visualModeKeyBindings": [
        { "before": [">"], "commands": ["editor.action.indentLines"] },
        { "before": ["<"], "commands": ["editor.action.outdentLines"] }
    ],
    "vim.operatorPendingModeKeyBindingsNonRecursive": [{ "before": ["("], "after": ["i("] }],
    "extensions.experimental.affinity": { "vscodevim.vim": 1 }, // To improve performance

    /*
    --------------------------------------------------------------------
    tailwindCSS
    --------------------------------------------------------------------
    */
    "tailwindCSS.emmetCompletions": true,
    "tailwindCSS.includeLanguages": { "typescriptreact": "javascript", "html": "html" },
    "diffEditor.hideUnchangedRegions.enabled": true
}
